{
	"name": "kiln",
	"private": true,
	"workspaces": [
		"packages/*",
		"apps/extension"
	],
	"scripts": {
		"dev": "bun run --cwd apps/extension dev",
		"dev:firefox": "bun run --cwd apps/extension dev:firefox",
		"dev:api": "bun run --filter @kiln/api dev",
		"dev:all": "bun run dev & bun run dev:api",
		"build": "bun run --filter @kiln/extension build",
		"build:firefox": "bun run --filter @kiln/extension build:firefox",
		"zip": "bun run --filter @kiln/extension zip",
		"zip:firefox": "bun run --filter @kiln/extension zip:firefox",
		"compile": "bun run --filter @kiln/extension compile",
		"start": "bun run --filter @kiln/api start",
		"db:generate": "bun run --filter @kiln/api db:generate",
		"db:push": "bun run --filter @kiln/api db:push",
		"db:migrate": "bun run --filter @kiln/api db:migrate",
		"db:seed": "bun run --filter @kiln/api db:seed",
		"db:faker": "bun run --filter @kiln/api db:faker",
		"deploy:api": "bun run --filter @kiln/api deploy:api",
		"deploy:extension": "bun run --filter @kiln/extension deploy:extension",
		"check": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.10"
	},
	"overrides": {
		"zod": "^4.3.6"
	},
	"dependencies": {
		"@types/bun": "^1.3.12",
		"bun": "^1.3.12",
		"node-html-parser": "^7.1.0"
	}
}